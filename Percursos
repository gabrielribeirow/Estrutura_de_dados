import java.util.LinkedList;
import java.util.Queue;

class No {
    int valor;
    No esquerdo, direito;

    public No(int valor) {
        this.valor = valor;
        esquerdo = direito = null;
    }
}

class Arvore {
    No raiz;

    public int contarNos(No no) {
        if (no == null) {
            return 0;
        }
        return 1 + contarNos(no.esquerdo) + contarNos(no.direito);
    }
public void buscaPreOrdem(No no) {
        if (no != null) {
            System.out.println(no.valor + " ");
            buscaPreOrdem(no.esquerdo);
            buscaPreOrdem(no.direito);
        }
    }

    public void buscaPosOrdem(No no) {
        if (no != null) {
            buscaPosOrdem(no.esquerdo);
            buscaPosOrdem(no.direito);
            System.out.print(no.valor + " ");
        }
    }

    public void buscaEmOrdem(No no) {
        if (no == null) {
           buscaEmOrdem(no.esquerdo);
           System.out.print(no.valor + " ");
           buscaEmOrdem(no.direito);
        }
    }
    public void buscaEmNivel(){
        if (raiz == null) return;

        Queue<No> fila = new LinkedList<>();
        fila.add(raiz);

        while (!fila.isEmpty()) {
            No atual = fila.poll();
            System.out.print(atual.valor + " ");

            if (atual.esquerdo != null) {
                fila.add(atual.esquerdo);
            }
            if (atual.direito != null) {
                fila.add(atual.direito);
            }
        }
    }
}
